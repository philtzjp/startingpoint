#!/bin/sh
# コミットメッセージを Philtz の規約で検査する。
# 検査器と規約は philtzjp/skills の conventions スキルにあり、正本は philtzjp/pulumi の .github/conventions.yml。
# ここに規則を書き足さない。規約を変えるときは philtzjp/pulumi の .github/conventions.yml を直す

export LANG=ja_JP.UTF-8
export LC_ALL=ja_JP.UTF-8

CLI=.agents/skills/conventions/cli.mjs

if [ ! -f "$CLI" ]; then
    echo "書式の検査器がありません。リポジトリの直下で AGENTS.md のコマンドを実行し、conventions スキルを入れてください"
    exit 1
fi

exec node "$CLI" commit-msg "$1"
