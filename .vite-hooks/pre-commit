#!/bin/sh
# 暗号化されていない .env* がコミットに混入していないかを検査し、ステージしたファイルを整形する。

export LANG=ja_JP.UTF-8
export LC_ALL=ja_JP.UTF-8
# core.hooksPath を .vite-hooks に直接向けた場合も vp と fallow を見つけられるようにする
PATH="$(git rev-parse --show-toplevel)/node_modules/.bin:$PATH"

EXPECTED='#/-------------------[DOTENV_PUBLIC_KEY]--------------------/'
FAILED=0

while IFS= read -r file; do
    if [ -z "$file" ]; then
        continue
    fi
    case "$(basename "$file")" in
        .env*) ;;
        *) continue ;;
    esac
    if [ ! -f "$file" ]; then
        continue
    fi
    FIRST_LINE=$(head -n 1 "$file")
    case "$FIRST_LINE" in
        "$EXPECTED"*) ;;
        *)
            echo "$file の1行目が暗号化ヘッダで始まっていません。暗号化されていない環境変数が混入している可能性があります。dotenvx encrypt で暗号化してください"
            FAILED=1
            ;;
    esac
done <<INNER
$(git diff --cached --name-only --diff-filter=ACM)
INNER

if [ "$FAILED" -ne 0 ]; then
    exit 1
fi

# ステージしたファイルを Vite+ で整形する。設定は vite.config.ts の staged
exec vp staged
